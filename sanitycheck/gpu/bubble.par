userSections = tlsr, clsr, lvlset

[GENERAL]
polynomialOrder = 9

stopAt = endTime
endTime = 10
dt = 0.001
timeStepper = tombo2
startFrom = restart.fld
checkpointControl = simulationTime
checkpointInterval = 0.5

scalars = tls, cls, c

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
boundaryTypeMap = none
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[TLSR]
solveFrequency = 0.1
regularization = svv+scalingCoeff=1.0+filterPower=6.0
residualTol = 1e-8
targetCFL = 0.4
maximumSteps = 400

[CLSR]
solveFrequency = 0.01
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8
targetCFL = 0.2
maximumSteps = 250

[LVLSET]
interfaceWidthFactor = 3.0

userSections = tlsr, clsr, lvlset

[GENERAL]
polynomialOrder = 9

stopAt = endTime
endTime = 10
dt = 0.001
timeStepper = tombo2
#startFrom = restart.fld
checkpointControl = simulationTime
checkpointInterval = 0.5

scalars = tls, cls, c

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration
solver = none
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[TLSR]
solveFrequency = 0.1
residualTol = 1e-8

[CLSR]
solveFrequency = 0.01
residualTol = 1e-8

[LVLSET]
interfaceWidthFactor = 1.5

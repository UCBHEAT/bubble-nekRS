#ifdef __okl__

#include "bubble3d.oudf"

#endif

#include "lvlSet.hpp"
#include "util.hpp"

#include "case.hpp"
#include "customhooks.hpp"

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
    kernelInfo.define("p_PI") = M_PI;
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
    options.setArgs("FLUID PRESSURE RHO SPLITTING", "TRUE");
    options.setArgs("FLUID PRESSURE RHO SPLITTING FILTER", "TRUE");
    options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");
}

void UDF_Setup() 
{
    mesh_t *mesh = nrs->meshV;

    nrs->userProperties = &customProperties;
    nrs->userSource = &customSource;

    lvlSet::setup();

    if (platform->options.getArgs("RESTART FILE NAME").empty()) {
        // Apply initial conditions.
        auto [x, y, z] = mesh->xyzHost();
        std::vector<dfloat> phi(nrs->fieldOffset, 0.0);
        for (int n = 0; n < mesh->Nlocal; n++) {
            dfloat r = sqrt(x[n]*x[n] + (y[n]-1)*(y[n]-1) + z[n]*z[n]);
            phi[n] = r-0.5;
        }

        // Copy to device memory.
        nrs->scalar->o_solution("tls").copyFrom(phi.data(), phi.size());

        // Generate psi and c initial conditions from phi.
        lvlSet::initHeaviside(nrs->scalar->o_solution("tls"), nrs->scalar->o_solution("cls"));
        lvlSet::initHeaviside(nrs->scalar->o_solution("tls"), nrs->scalar->o_solution("c"));
    }

    // These must be calculated and passed to device kernels as arguments, as the mesh
    // is not loaded yet (nrs->meshV is still a null pointer) in UDF_LoadKernels so we
    // cannot set them as defines there.
    printf("MPI rank %d: Nelements=%d Nlocal/Np=%d\n", platform->comm.mpiRank(), mesh->Nelements, mesh->Nlocal/(mesh->Np));
    info.Nelements = mesh->Nlocal/(mesh->Np);
    // mesh->Nelements is the minimum number of elements per node. This is not always
    // the number of elements on this MPI rank when the number of elements is not exactly
    // divisble by the MPI rank.
    info.fieldOffset = nrs->fieldOffset;
    info.liquid_volume = platform->linAlg->innerProd(mesh->Nlocal, 
            nrs->scalar->o_solution("cls"), mesh->o_Jw, platform->comm.mpiComm());
    info.gas_volume = mesh->volume - info.liquid_volume;
    info.rho_average = (info.liquid_volume + (info.gas_volume/rhoratio))/(mesh->volume);
    if (platform->comm.mpiRank() == 0) {
        printf("Liquid/gas/total volumes %.4g %.4g %.4g\n", info.liquid_volume, info.gas_volume, mesh->volume);
        printf("rho_average=%.4g\n", info.rho_average);
    }
    info.cumulative_c_sink = 0.0;
    info.cumulative_dt = 0.0;
    platform->options.getArgs("DT", info.dt);
}

void UDF_ExecuteStep(double time, int tstep) 
{
    mesh_t* mesh = nrs->meshV;
    scalar_t* scalar = nrs->scalar.get();
    fluidSolver_t* fluid = nrs->fluid.get();
    const occa::memory o_psi = scalar->o_solution("cls");
    const occa::memory o_phi = scalar->o_solution("tls");
    const occa::memory o_c = scalar->o_solution("c");

    lvlSet::solve(time);

    // Hard sink.
    {
        occa::memory o_cSink = platform->device.malloc<dfloat>(nrs->fieldOffset);
        hardSink(info, o_c, o_psi, o_cSink);
        dfloat sink = platform->linAlg->innerProd(mesh->Nlocal, o_cSink, mesh->o_Jw, platform->comm.mpiComm());
        info.cumulative_c_sink += sink;
        info.cumulative_dt += info.dt;
    }

    if (nrs->checkpointStep) {
        dfloat mdot = info.cumulative_c_sink / info.cumulative_dt;
        info.cumulative_c_sink = 0.0;
        info.cumulative_dt = 0.0;

        // Calculate c_bulk.
        occa::memory o_cpsi = platform->device.malloc<dfloat>(nrs->fieldOffset);
        platform->linAlg->axmyz(mesh->Nlocal, 1.0, o_c, o_psi, o_cpsi); // o_cpsi[i] = o_c[i]*o_psi[i]
        dfloat c_bulk = platform->linAlg->innerProd(mesh->Nlocal, o_cpsi, mesh->o_Jw, platform->comm.mpiComm()) / info.liquid_volume;

        // Calculate MTC and Sh.
        dfloat total_area = platform->linAlg->innerProd(mesh->Nlocal, lvlSet::getDeltaFunction(), mesh->o_Jw, platform->comm.mpiComm());
        dfloat mtc = mdot / total_area / c_bulk;
        dfloat sherwood_no = mtc*Pe;

        if (platform->comm.mpiRank() == 0) {
            printf("----------------------------------------\n");
            printf("Interphase species transport statistics:\n");
            printf("mdot=%.4g MTC=%.4g Sh=%.4g\n", mdot, mtc, sherwood_no);
            printf("total_area=%.4g c_bulk=%.4f\n", total_area, c_bulk);
            printf("----------------------------------------\n");

            // Write CSV file
            const std::string filename = "data.csv";
            std::ifstream check_file(filename);
            bool newly_created = !check_file.good();
            check_file.close();
            std::ofstream f(filename, std::ios_base::app);
            if (newly_created) {
                f << "Time,tstep,mdot,MTC,Sh,total_area,c_bulk" << std::endl;
            }
            // %.4g = defaultfloat, precision 4; %.4f = fixed, precision 4
            f << std::fixed << std::setprecision(4) << time << ",";
            f << tstep << ",";
            f << std::defaultfloat << std::setprecision(4) << mdot << ","
                    << mtc << "," << sherwood_no << "," << total_area << ",";
            f << std::fixed << std::setprecision(4) << c_bulk;
            f << std::endl;
            f.close();
        } // if (platform->comm.mpiRank() == 0)
    } // if (nrs->checkpointStep)
}

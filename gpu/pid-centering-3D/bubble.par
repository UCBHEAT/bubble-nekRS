userSections = tlsr, clsr, lvlset, pid

[GENERAL]
polynomialOrder = 7

stopAt = endTime
endTime = 20
# Settings for the default mesh (./mesh, 0.2 cubes around the bubble); for
# another preset take them from bubble.plan.json ("nekrs_ls").
# Explicit surface tension limits dt: in 2D, 0.8x the capillary estimate
# sqrt((rho_l+rho_g)*(h/N)^3/(4*pi*sigma)) was stable and ~0.96x was not. That
# 0.8x value is 1.8e-3 at h = 0.2, N = 7; dt = 1.5e-3 leaves some margin, since
# 3D has not been tested yet.
dt = 0.0015
timeStepper = tombo2
#startFrom = restart.fld
checkpointControl = simulationTime
# A 3D field file is ~0.1-0.2 GB at N = 7 (4.3 M GLL points).
checkpointInterval = 0.5

scalars = tls, cls, c

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
# Boundary IDs (gmsh physical groups, see generate_mesh.py): 1 = top (inflow),
# 2 = bottom (outflow); x and z are periodic. The inflow velocity is the PID
# frame velocity.
boundaryTypeMap = udfDirichlet, zeroNeumann
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
boundaryTypeMap = zeroNeumann, zeroNeumann
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]; psi = 1 (liquid) at the inflow
boundaryTypeMap = udfDirichlet, zeroNeumann
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration (passive, CST off; hard sink in the gas); saturated
# c = 1 liquid at the inflow
boundaryTypeMap = udfDirichlet, zeroNeumann
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[TLSR]
# The reinitialization intervals are left at the lvlSet defaults, every 100
# (TLSR) and 10 (CLSR) steps (solveFrequency = 100*dt and 10*dt, so they follow
# dt), as is residualTol (1e-8). The pseudo-step count scales with the
# largest/smallest element size; cap it at the uniform-mesh value 25*(N+1),
# which covers the fine block around the bubble (the default cap is 1000).
maximumSteps = 200

[CLSR]
# Capped at the uniform-mesh value 10*(N+1), as for TLSR (default 500).
maximumSteps = 80

[LVLSET]
# eps = 1.5*h/N for the h = 0.2 cube elements around the bubble (default
# mesh, N = 7; bubble.plan.json gives it for other meshes). Set it directly,
# since by default lvlSet uses the largest element of the graded mesh, which
# here would give eps ~0.12 (R/eps ~4.1; 0.18 with interfaceWidthFactor =
# 1.5). R/eps = 11.7 here; in 2D the gas core went unstable at R/eps = 5.9 and
# was clean at 9.3.
interfaceWidthValue = 0.0429

[PID]
# Bubble centering controller (see ../common/pid.hpp): a uniform acceleration
# F_pid = -(kp*e + ki*integral(e dt) + kd*u_gas) is applied to the whole domain,
# where e is the gas centroid offset from the setpoint (x0, y0, z0) and u_gas is
# the gas-phase mean velocity (used as de/dt). F_pid accelerates the bubble
# directly (e'' = F_pid + buoyancy - drag), so e obeys
#   e''' + kd e'' + kp e' + ki e = d/dt(buoyancy - drag),
# whose characteristic polynomial s^3 + kd s^2 + kp s + ki (s: the Laplace
# variable, i.e. solutions ~ e^(s t)) is (s + 2)^3 for the gains below. All
# three roots are at s = -2 (a "triple closed-loop pole at s = -2"): an offset
# decays like e^(-2t), with a time constant of 0.5, without oscillating. To make
# the loop faster or slower, put the poles at s = -a with kp = 3a^2, ki = a^3,
# kd = 3a.
kp = 12
ki = 8
kd = 6
# Frontal area for the steady-state C_D report; 0 (default) uses the frontal
# area of the sphere of equal gas volume, which is the right estimate while the
# bubble is near-spherical here (comment out to fall back to it).
# frontalArea = 0.7854
# Setpoint: the initial bubble position (the default is the mesh centroid).
x0 = 0
y0 = 0
z0 = 0

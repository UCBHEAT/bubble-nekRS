userSections = tlsr, clsr, lvlset

[MESH]
# Known good settings
# Kolmogorov scale = 0.0671 mm
# no hrefine (12x24x12) + order 5 = local development (0.17 mm)
hrefine = 2 # hrefine 2 + order 5 = 127% Kolmogorov scale (0.085 mm)
#hrefine = 4 # hrefine 4 + order 5 = 64% Kolmogorov scale (0.043 mm)
#hrefine = 4,2 # 32%
#hrefine = 4,3 # 21%

# Not known good settings
#hrefine = 26 # hrefine 26 + order 5 = 10% Kolmogorov scale (0.0066 mm)
#hrefine = 3 # hrefine 3 + order 5 = 85% Kolmogorov scale (0.057 mm)

[GENERAL]
# Uncomment to debug per-field internal iterations.
#verbose = true
# Uncomment to resume from a checkpoint.
#startFrom = startup.fld

polynomialOrder = 5

stopAt = endTime
endTime = 30
#dt = 4e-3 # local development
#dt = 2e-3 # 127% Kolmogorov scale
dt = 0.5e-3 # 64% Kolmogorov scale (extra halving)
#dt = 0.25e-3 # 32%
#dt = 0.1667e-3 # 21%
#
#dt = 0.1538e-3 # 10% Kolmogorov scale
#dt = 1.3333e-3 # 85% Kolmogorov scale
#dt = 1e-4 # Nek5000
timeStepper = tombo2
checkpointControl = simulationTime
checkpointInterval = 0.1

scalars = tls, cls, c

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
boundaryTypeMap = none
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[TLSR]
boundaryTypeMap = none
#solveFrequency = 0.2 # local development (40 timesteps)
#solveFrequency = 0.1 # 127% Kolmogorov scale (40 timesteps)
solveFrequency = 0.025 # 64% Kolmogorov scale (40 timesteps)
#solveFrequency = 0.0125 # 32%
#solveFrequency = 0.008333 # 21%
#
#solveFrequency = 0.1538e-2 # 10% Kolmogorov scale (10 timesteps)
#solveFrequency = 1.3333e-1 # 85% Kolmogorov scale (100 timesteps)
#solveFrequency=1e-2 # Nek5000
regularization = svv+scalingCoeff=1.0+filterPower=6.0
residualTol = 1e-8
targetCFL = 0.4
maximumSteps = 200

[CLSR]
boundaryTypeMap = none
#solveFrequency = 0.02 # local development (4 timesteps)
#solveFrequency = 0.01 # 127% Kolmogorov scale (4 timesteps)
solveFrequency = 0.0025 # 64% Kolmogorov scale (4 timesteps)
#solveFrequency = 0.00125 # 32%
#solveFrequency = 0.0008333 # 21%
#
#solveFrequency = 0.1538e-3 # 10% Kolmogorov scale (1 timestep)
#solveFrequency = 1.3333e-2 # 85% Kolmogorov scale (10 timesteps)
#solveFrequency=1e-3 # Nek5000
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8
targetCFL = 0.2
maximumSteps = 20

[LVLSET]
interfaceWidthFactor = 1.5

#ifdef __okl__

#include "bubble3d.oudf"

#endif

#include "lvlSet.hpp"
#include "util.hpp"

#include "case.hpp"
#include "customhooks.hpp"

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
    kernelInfo.define("p_PI") = M_PI;
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
    options.setArgs("FLUID PRESSURE RHO SPLITTING", "TRUE");
    options.setArgs("FLUID PRESSURE RHO SPLITTING FILTER", "TRUE");
    options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");
}

void UDF_Setup() 
{
    mesh_t *mesh = nrs->meshV;

    nrs->userProperties = &customProperties;
    nrs->userSource = &customSource;

    lvlSet::setup();

    if (platform->options.getArgs("RESTART FILE NAME").empty()) {
        // Apply initial conditions.
        auto [x, y, z] = mesh->xyzHost();
        std::vector<dfloat> phi(nrs->fieldOffset, 0.0);
        for (int n = 0; n < mesh->Nlocal; n++) {
            dfloat r = sqrt(x[n]*x[n] + (y[n]-1)*(y[n]-1) + z[n]*z[n]);
            phi[n] = r-0.5;
        }

        // Copy to device memory.
        nrs->scalar->o_solution("tls").copyFrom(phi.data(), phi.size());

        // Generate psi and c initial conditions from phi.
        lvlSet::initHeaviside(nrs->scalar->o_solution("tls"), nrs->scalar->o_solution("cls"));
        lvlSet::initHeaviside(nrs->scalar->o_solution("tls"), nrs->scalar->o_solution("c"));
    }

    // These must be calculated and passed to device kernels as arguments, as the mesh
    // is not loaded yet (nrs->meshV is still a null pointer) in UDF_LoadKernels so we
    // cannot set them as defines there.
    printf("MPI rank %d: Nelements=%d Nlocal/Np=%d\n", platform->comm.mpiRank(), mesh->Nelements, mesh->Nlocal/(mesh->Np));
    info.Nelements = mesh->Nlocal/(mesh->Np);
    // mesh->Nelements is the minimum number of elements per node. This is not always
    // the number of elements on this MPI rank when the number of elements is not exactly
    // divisble by the MPI rank.
    info.fieldOffset = nrs->fieldOffset;
    info.liquid_volume = platform->linAlg->innerProd(mesh->Nlocal, 
            nrs->scalar->o_solution("cls"), mesh->o_Jw, platform->comm.mpiComm());
    info.gas_volume = mesh->volume - info.liquid_volume;
    info.rho_average = (info.liquid_volume + rhoratio*(info.gas_volume))/(mesh->volume);
    if (platform->comm.mpiRank() == 0) {
        printf("Liquid/gas/total volumes %.4g %.4g %.4g\n", info.liquid_volume, info.gas_volume, mesh->volume);
        printf("rho_average=%.4g\n", info.rho_average);
    }
}

void UDF_ExecuteStep(double time, int tstep) 
{
    mesh_t* mesh = nrs->meshV;
    scalar_t* scalar = nrs->scalar.get();
    fluidSolver_t* fluid = nrs->fluid.get();
    const occa::memory o_psi = scalar->o_solution("cls");
    const occa::memory o_phi = scalar->o_solution("tls");
    const occa::memory o_c = scalar->o_solution("c");

    lvlSet::solve(time);

    if (nrs->checkpointStep) {

        // Calculate MTC via volume integral(diffusion and CST fluxes . interface normals)/(c_bulk - c_bubble)
        occa::memory o_interfaceNormalVector = platform->device.malloc<dfloat>(3*(nrs->fieldOffset));
        occa::memory o_interfaceNormalVectorX = o_interfaceNormalVector.slice(0*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_interfaceNormalVectorY = o_interfaceNormalVector.slice(1*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_interfaceNormalVectorZ = o_interfaceNormalVector.slice(2*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstDiffVector = platform->device.malloc<dfloat>(3*(nrs->fieldOffset));
        occa::memory o_cstDiffVectorX = o_cstDiffVector.slice(0*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstDiffVectorY = o_cstDiffVector.slice(1*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstDiffVectorZ = o_cstDiffVector.slice(2*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstSrcVector = platform->device.malloc<dfloat>(3*(nrs->fieldOffset));
        occa::memory o_cstSrcVectorX = o_cstSrcVector.slice(0*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstSrcVectorY = o_cstSrcVector.slice(1*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_cstSrcVectorZ = o_cstSrcVector.slice(2*nrs->fieldOffset, nrs->fieldOffset);

        // Calculate interface unit normals.
        opSEM::strongGrad(mesh, nrs->fieldOffset, o_phi, o_interfaceNormalVector);
        interfaceNormals(info, o_phi, lvlSet::getDeltaFunction(), o_interfaceNormalVectorX, o_interfaceNormalVectorY, o_interfaceNormalVectorZ);

        // Calculate CST diffusion flux.
        opSEM::strongGrad(mesh, nrs->fieldOffset, o_c, o_cstDiffVector);
        platform->linAlg->axmyMany(mesh->Nlocal, /* Nfields */ 3, nrs->fieldOffset, /* mode */ 0,
                /* constant multiplier */ 1.0, scalar->o_diffusionCoeff("c"), o_cstDiffVector);

        // Calculate CST source flux.
        o_cstSrcVector.copyFrom(o_interfaceNormalVector, 3*nrs->fieldOffset);
        speciesSource(info, o_c, o_psi, solubilityratio, diffratio, Pe, o_cstSrcVectorX, o_cstSrcVectorY, o_cstSrcVectorZ);

        // Sum CST fluxes: o_cstSrcVector = o_cstDiffVector + o_cstSrcVector [mol/(m^2 s)].
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_cstDiffVectorX, 1.0, o_cstSrcVectorX);
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_cstDiffVectorY, 1.0, o_cstSrcVectorY);
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_cstDiffVectorZ, 1.0, o_cstSrcVectorZ);

        // Calculate interface mass transfer rate per unit volume as
        // o_interface_mass_transfer_rate [mol/(m^3 s)] = o_cstSrcVector [mol/(m^2 s)] . o_interfaceNormalVector [m^2/m^3].
        occa::memory o_interface_mass_transfer_rate = platform->device.malloc<dfloat>(3*nrs->fieldOffset);
        occa::memory o_interface_mass_transfer_rateX = o_interface_mass_transfer_rate.slice(0*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_interface_mass_transfer_rateY = o_interface_mass_transfer_rate.slice(1*nrs->fieldOffset, nrs->fieldOffset);
        occa::memory o_interface_mass_transfer_rateZ = o_interface_mass_transfer_rate.slice(2*nrs->fieldOffset, nrs->fieldOffset);
        platform->linAlg->dotProduct(mesh->Nlocal, nrs->fieldOffset, o_cstSrcVector, o_interfaceNormalVector, o_interface_mass_transfer_rate);
        // o_interface_mass_transfer_rateX = o_interface_mass_transfer_rateX + o_interface_mass_transfer_rateY + o_interface_mass_transfer_rateZ
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_interface_mass_transfer_rateY, 1.0, o_interface_mass_transfer_rateX);
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_interface_mass_transfer_rateZ, 1.0, o_interface_mass_transfer_rateX);

        // Integrate for total_mass_transfer_rate [mol/s]; divide by volume for vol_avg_mass_transfer_rate [mol/(m^3 s)].
        dfloat total_mass_transfer_rate = platform->linAlg->innerProd(mesh->Nlocal, o_interface_mass_transfer_rateX, mesh->o_Jw, platform->comm.mpiComm());

        // Calculate c_bulk, c_bubble, and C_total.
        occa::memory o_cpsi = platform->device.malloc<dfloat>(nrs->fieldOffset);
        platform->linAlg->axmyz(mesh->Nlocal, 1.0, o_c, o_psi, o_cpsi); // o_cpsi[i] = o_c[i]*o_psi[i]
        dfloat c_bulk = platform->linAlg->innerProd(mesh->Nlocal, o_cpsi, mesh->o_Jw, platform->comm.mpiComm()) / info.liquid_volume;
        platform->linAlg->axpby(mesh->Nlocal, 1.0, o_c, -1.0, o_cpsi); // o_cpsi[i] = o_c[i]*(1-o_psi[i])
        dfloat c_bubble = platform->linAlg->innerProd(mesh->Nlocal, o_cpsi, mesh->o_Jw, platform->comm.mpiComm()) / info.gas_volume;
        dfloat C_total = platform->linAlg->innerProd(mesh->Nlocal, o_c, mesh->o_Jw, platform->comm.mpiComm());

        // Calculate MTC and Sh.
        dfloat total_area = platform->linAlg->innerProd(mesh->Nlocal, lvlSet::getDeltaFunction(), mesh->o_Jw, platform->comm.mpiComm());
        dfloat mtc = total_mass_transfer_rate / total_area / (c_bulk - c_bubble/solubilityratio);
        dfloat sherwood_no = mtc*Pe;

        if (platform->comm.mpiRank() == 0) {
            printf("----------------------------------------\n");
            printf("Interphase species transport statistics:\n");
            printf("mdot=%.4g MTC=%.4g Sh=%.4g\n", total_mass_transfer_rate, mtc, sherwood_no);
            printf("c_bulk=%.4f c_bubble=%.4f\n", c_bulk, c_bubble);
            printf("C conservation error=%.4g (negative=loss, positive=gain)\n", C_total - info.liquid_volume);
            printf("----------------------------------------\n");
        }

        // Write CSV files for timestep -- both combined and per-timestep files.
        const std::string filename_combined = "data.csv";
        std::ifstream check_file(filename_combined);
        bool newly_created = !check_file.good();
        check_file.close();
        std::ofstream f_combined(filename_combined, std::ios_base::app);
        if (newly_created) {
            f_combined << "Time,tstep,mdot,MTC,Sh,c_bulk,c_bubble,C_conservation_error" << std::endl;
        }

        std::stringstream filename_ss;
        filename_ss << std::fixed << std::setprecision(2) << "data_" << time << ".csv";
        const std::string filename_pertimestep(filename_ss.str());
        std::ofstream f_pertimestep(filename_pertimestep);

        for (std::ofstream* f : {&f_combined, &f_pertimestep}) {
            // %.4g = defaultfloat, precision 4; %.4f = fixed, precision 4
            *f << std::fixed << std::setprecision(4) << time << ",";
            *f << tstep << ",";
            *f << std::defaultfloat << std::setprecision(4) << total_mass_transfer_rate << "," << mtc << "," << sherwood_no << ",";
            *f << std::fixed << std::setprecision(4) << c_bulk << "," << c_bubble << ",";
            *f << std::defaultfloat << std::setprecision(4) << (C_total - info.liquid_volume);
            *f << std::endl;
            f->close();
        }
    } // if (nrs->checkpointStep)
}

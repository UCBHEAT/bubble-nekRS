userSections = tlsr, clsr, lvlset

[MESH]
# Kolmogorov scale = 0.0671 mm
# no hrefine (12x24x12) + order 5 = local development (0.17 mm)
hrefine = 26 # hrefine 26 + order 5 = 1/10 Kolmogorov scale (0.0066 mm)

[GENERAL]
# Uncomment to debug per-field internal iterations.
#verbose = true
# Uncomment to resume from a checkpoint.
#startFrom = startup.fld

polynomialOrder = 5

stopAt = endTime
endTime = 30
#dt = 4e-3 # local development
dt = 0.1538e-3 # 1/10 Kolmogorov scale
timeStepper = tombo2
checkpointControl = simulationTime
checkPointInterval = 0.1

scalars = tls, cls, c

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
boundaryTypeMap = none
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+scalingCoeff=1.0+filterPower=2.0

[TLSR]
boundaryTypeMap = none
#solveFrequency = 0.2 # local development
#solveFrequency = 0.007692 # 1/10 Kolmogorov scale
solveFrequency = 0.1538e-2 # 1/10 Kolmogorov scale
regularization = svv+scalingCoeff=1.0+filterPower=6.0
residualTol = 1e-8
targetCFL = 0.4
maximumSteps = 200

[CLSR]
boundaryTypeMap = none
#solveFrequency = 0.02 # local development
#solveFrequency = 0.0007692 # 1/10 Kolmogorov scale
solveFrequency = 0.1538e-3 # 1/10 Kolmogorov scale
regularization = svv+scalingCoeff=1.0+filterPower=4.0
residualTol = 1e-8
targetCFL = 0.2
maximumSteps = 20

[LVLSET]
interfaceWidthFactor = 1.5

userSections = tlsr, clsr, lvlset

[GENERAL]
# Uncomment to debug per-field internal iterations.
#verbose = true
# Uncomment to resume from a checkpoint.
startFrom = 32x64x32-ord5-startup.fld # production
#startFrom = 12x24x12-ord5-startup.fld # local development

polynomialOrder = 5

stopAt = endTime
endTime = 100
dt = initial=3.0e-7+targetCFL=0.4+max=6.0e-7 # production, real rhoratio
#dt = initial=3.0e-5+targetCFL=0.4+max=6.0e-5 # production, startup
#dt = initial=1.0e-6+targetCFL=0.4+max=2.0e-6 # local development, real rhoratio
#dt = initial=1.0e-4+targetCFL=0.4+max=2.0e-4 # local development, startup
timeStepper = tombo2
checkpointControl = simulationTime
checkPointInterval = 0.1
# To generate startup file, set rhoratio=1/40 (rather than ~1/4000)
# and increase dt by 100x correspondingly. Run to t=1 or so and then switch
# to real rhoratio and the real rhoratio dt settings.
# - You can use the same Sc=1150 startup file in all Sc cases.
# - Should targetCFL be divided by rhoratio too? Currently dynamic
#   timestepping isn't really doing anything.

scalars = tls, cls, c, debug1, debug2, debug3

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID VELOCITY]
boundaryTypeMap = none
regularization = svv+svvCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[FLUID PRESSURE]
residualTol = 1e-4

[SCALAR TLS]
# TLS (traditional level set), domain: (-infty, infty)
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+svvCoeff=1.0+filterPower=2.0

[SCALAR CLS]
# CLS (conservative level set), domain: [0, 1]
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+svvCoeff=1.0+filterPower=2.0

[SCALAR C]
# Species concentration
boundaryTypeMap = none
transportCoeff = 1.0
diffusionCoeff = 1e-10
residualTol = 1e-8
regularization = svv+svvCoeff=1.0+filterPower=2.0

[SCALAR DEBUG1]
solver = none
[SCALAR DEBUG2]
solver = none
[SCALAR DEBUG3]
solver = none

[TLSR]
boundaryTypeMap = none
solveFrequency = 1e-2
regularization = svv+svvCoeff=1.0+filterPower=6.0
residualTol = 1e-8

[CLSR]
boundaryTypeMap = none
solveFrequency = 1e-3
regularization = svv+svvCoeff=1.0+filterPower=4.0
residualTol = 1e-8

[LVLSET]
interfaceWidthFactor = 1.5
